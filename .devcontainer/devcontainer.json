// https://pixi.sh/latest/integration/editor/vscode/#devcontainer-extension
{
  "name": "test-workspace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
    "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python"
      ]
    }
  },
  // Ensure paths to default pixi env and global tools are in $PATH
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.pixi/bin:${containerEnv:HOME}/.pixi/envs/default/bin/"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  // https://containers.dev/implementors/json_reference/#formatting-string-vs-array-properties
  "postCreateCommand": {
    "set_permissions": "sudo chown vscode .pixi",
    // "install_global_tools": "pixi global install -e jupyterlab jupyterlab jupyterlab-myst pixi-kernel",
    // TODO: how to expose logs from this?...
    "install_repo_env": "pixi install"
  }
}
